{
	"name": "techdoc-ai",
	"private": true,
	"packageManager": "bun@1.3.12",
	"workspaces": [
		"frontend"
	],
	"scripts": {
		"dev": "bun run --filter techdoc-ai-frontend dev",
		"build": "bun run --filter techdoc-ai-frontend build",
		"format": "bun run --filter techdoc-ai-frontend format",
		"lint": "bun run --filter techdoc-ai-frontend lint",
		"lint:check": "bun run --filter techdoc-ai-frontend lint:check",
		"test": "bun run --filter techdoc-ai-frontend test",
		"test:ui": "bun run --filter techdoc-ai-frontend test:ui"
	},
	"overrides": {
		"@babel/core": "7.29.7",
		"form-data": "4.0.6",
		"picomatch": "4.0.5",
		"tar": "7.5.20",
		"lodash": "4.18.1",
		"defu": "6.1.7",
		"handlebars": "4.7.9",
		"js-yaml": "4.3.0"
	}
}
