PROJECT_NAME=TechDoc AI
STACK_NAME=techdoc-ai
DOMAIN=localhost
ENVIRONMENT=local
FRONTEND_HOST=http://localhost:5173
BACKEND_CORS_ORIGINS=http://localhost:5173

DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

SECRET_KEY=replace-with-at-least-32-random-bytes
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-with-a-strong-password

POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password

BGE_MODEL_HOST_PATH=/absolute/path/to/bge-m3
EMBEDDING_MODEL_PATH=/models/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_USE_FP16=false
EMBEDDING_BATCH_SIZE=4
EMBEDDING_MAX_LENGTH=8192

REDIS_URL=redis://redis:6379/0
DOCUMENT_QUEUE_MAX_RETRIES=3

LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=
LLM_HISTORY_MESSAGES=10
LLM_MAX_CONTEXT_CHARS=12000

RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.55
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=50

CHAT_REQUESTS_PER_MINUTE=10
CHAT_REQUESTS_PER_DAY=200
UPLOAD_REQUESTS_PER_MINUTE=10
METRICS_ENABLED=true

SENTRY_DSN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
